{
  "version": 1,
  "goal": "Discover the Booking extranet API schema by visiting distinct data views, opening read-only tabs and expanding or paginating lists. Prefer controls likely to reveal new request methods, URL parameters and response shapes. Use only available actions. Do not submit edits, send messages, change rates or availability, cancel reservations, make payments or log out. Stop when permitted controls cannot add useful coverage. Coverage is heuristic and incomplete.",
  "max_steps": 24,
  "max_page_requests": 512,
  "max_get_probes": 64,
  "actions": [
    {"id": "view-reservations", "kind": "click", "selector": "nav a[href*='reservations'], a[data-testid='reservations-link']"},
    {"id": "view-rates-and-availability", "kind": "click", "selector": "nav a[href*='rates'], nav a[href*='availability']"},
    {"id": "view-property", "kind": "click", "selector": "nav a[href*='property'], nav a[href*='hotel_info']"},
    {"id": "view-reviews", "kind": "click", "selector": "nav a[href*='reviews']"},
    {"id": "view-analytics", "kind": "click", "selector": "nav a[href*='analytics'], nav a[href*='statistics']"},
    {"id": "view-finance", "kind": "click", "selector": "nav a[href*='finance'], nav a[href*='invoices']"},
    {"id": "view-messages", "kind": "click", "selector": "nav a[href*='inbox']"},
    {"id": "open-reservations-tab", "kind": "click", "selector": "button[role='tab'][data-testid='reservations-tab']"},
    {"id": "open-availability-tab", "kind": "click", "selector": "button[role='tab'][data-testid='availability-tab']"},
    {"id": "open-reviews-tab", "kind": "click", "selector": "button[role='tab'][data-testid='reviews-tab']"},
    {"id": "expand-reservation-details", "kind": "click", "selector": "button[data-testid='reservation-details'][aria-expanded='false']", "max_uses": 4},
    {"id": "next-data-page", "kind": "click", "selector": "a[rel='next'], button[data-testid='pagination-next']:not([disabled]):not([aria-disabled='true'])", "max_uses": 8},
    {"id": "load-more-records", "kind": "click", "selector": "button[data-testid='load-more']:not([disabled]):not([aria-disabled='true'])", "max_uses": 4}
  ]
}
