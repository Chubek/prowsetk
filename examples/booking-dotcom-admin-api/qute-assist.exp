#!/usr/bin/expect -f
# Interactive Qutebrowser Lua console; --one-shot retains the driver workflow.
#
# Starts the owner-only broker, prints the userscript attachment line and opens
# the Replxx/Lua console. --one-shot runs the finite driver instead.
# The inherently manual steps stay manual by design (open Qutebrowser, log in,
# solve MFA/human verification, run :spawn); the script never fabricates that
# consent. With --launch the broker's own [y/N] approval is relayed to you and
# answered only with your keystroke.
#
# Usage:
#   qute-assist.exp [--directory DIR] [--url URL] [--timeout SEC]
#     [--wait-ms MS] [--output FILE] [--postman FILE] [--actions-file FILE]
#     [--launch] [--browser BIN] [--success-selector SEL] [--success-xpath XPATH]
#     [--one-shot] [--repl-bin BIN] [--show-values] [--max-actions N]
#     [--bridge-bin BIN] [--cli-bin BIN] [--ipc-module SO] [--help]
#
# Exit: 0 on orderly REPL close or driver export, 1 on failure, 2 on usage errors.

# stdout remains usable after Expect observes stdin EOF from a pipeline.
# send_user's shared exp0 handle does not, and used to swallow the final status.
proc report {message} { puts -nonewline stdout $message; flush stdout }
rename send_user orig_send_user
proc send_user {message} { report $message }

set HERE [file dirname $argv0]
set DEFAULT_BRIDGE [file normalize "$HERE/../../tools/qutebrowser-bridge/ptk-qute-bridge"]
set DEFAULT_SCRAPE [file normalize "$HERE/../../tools/qutebrowser-bridge/ptk-qute-scrape"]
set DEFAULT_MARIONETTE [file normalize "$HERE/../../tools/qutebrowser-bridge/ptk-qute-marionette"]
set DEFAULT_CLI [file normalize "$HERE/../../build/default/src/cli/prowsetk"]
set DEFAULT_CONFIG [file normalize "$HERE/Prowse.toml"]
set DEFAULT_REPL [file normalize "$HERE/../../build/default/tools/qutebrowser-bridge/ptk-qute-repl"]

set directory "build/qute-booking"
set url "https://admin.booking.com/"
set timeout_secs 1800
set wait_ms 30000
set output "_scraped/booking-admin-openapi.yaml"
set postman "_scraped/booking-admin-postman.json"
set actions_file ""
set success_selector ""
set success_xpath ""
set launch 0
set browser "qutebrowser"
set bridge_bin ""
set cli_bin ""
set repl_bin ""
set interactive 1
set show_values 0
set max_actions 256

proc usage {} {
    send_user "Usage: qute-assist.exp \[options]\n"
    send_user "  --directory DIR   broker runtime dir (default: build/qute-booking)\n"
    send_user "  --url URL         must stay on https://admin.booking.com (default)\n"
    send_user "  --timeout SEC     broker lifetime 1..3600 (default: 1800)\n"
    send_user "  --wait-ms MS      snapshot/action wait 1..30000 (default: 30000)\n"
    send_user "  --output FILE     OpenAPI output (default: _scraped/booking-admin-openapi.yaml)\n"
    send_user "  --postman FILE    Postman output (default: _scraped/booking-admin-postman.json)\n"
    send_user "  --actions-file F  two-way marionette policy (switches to ptk-qute-marionette)\n"
    send_user "  --launch          open the URL in Qutebrowser (broker asks your approval)\n"
    send_user "  --browser BIN     browser for --launch (default: qutebrowser)\n"
    send_user "  --success-selector S CSS login-evidence override\n"
    send_user "  --success-xpath XPATH login-evidence override\n"
    send_user "  --bridge-bin BIN  ptk-qute-bridge override\n"
    send_user "  --cli-bin BIN     prowsetk CLI override\n"
    send_user "  --ipc-module SO   lquteipc override\n"
    send_user "  --one-shot        run the finite driver instead of the Lua REPL\n"
    send_user "  --repl-bin BIN    ptk-qute-repl override\n"
    send_user "  --show-values     opt into local target labels in the REPL\n"
    send_user "  --max-actions N   bounded interaction budget, 0..256 (default: 256)\n"
}

set ipc_module ""
set i 0
while {$i < [llength $argv]} {
    set opt [lindex $argv $i]
    if {$opt eq "--help" || $opt eq "-h"} { usage; exit 0 }
    if {$opt in {"--launch"}} { set launch 1; incr i; continue }
    if {$opt eq "--one-shot"} { set interactive 0; incr i; continue }
    if {$opt eq "--show-values"} { set show_values 1; incr i; continue }
    if {$opt ni {"--directory" "--url" "--timeout" "--wait-ms" "--output" "--postman" "--actions-file" "--browser" "--success-selector" "--success-xpath" "--bridge-bin" "--cli-bin" "--ipc-module" "--repl-bin" "--max-actions"}} {
        send_user "qute-assist.exp: unknown option $opt\n"; exit 2
    }
    if {$i + 1 >= [llength $argv]} { send_user "qute-assist.exp: missing value for $opt\n"; exit 2 }
    set val [lindex $argv [expr {$i + 1}]]
    switch -- $opt {
        "--directory"    { set directory $val }
        "--url"          { set url $val }
        "--timeout"      { set timeout_secs $val }
        "--wait-ms"      { set wait_ms $val }
        "--output"       { set output $val }
        "--postman"      { set postman $val }
        "--actions-file" { set actions_file $val; set interactive 0 }
        "--browser"      { set browser $val }
        "--success-selector" { set success_selector $val }
        "--success-xpath" { set success_xpath $val }
        "--bridge-bin"   { set bridge_bin $val }
        "--cli-bin"      { set cli_bin $val }
        "--ipc-module"   { set ipc_module $val }
        "--repl-bin"     { set repl_bin $val }
        "--max-actions"  { set max_actions $val }
        default { send_user "qute-assist.exp: unknown option $opt\n"; exit 2 }
    }
    incr i 2
}
if {![regexp {^https://admin\.booking\.com(?::443)?(?:[/?#]|$)} $url]} {
    send_user "qute-assist.exp: URL must stay on https://admin.booking.com\n"
    exit 2
}
if {![string is integer -strict $timeout_secs] || $timeout_secs < 1 || $timeout_secs > 3600} {
    send_user "qute-assist.exp: --timeout must be 1..3600\n"
    exit 2
}
if {![string is integer -strict $wait_ms] || $wait_ms < 1 || $wait_ms > 30000} {
    send_user "qute-assist.exp: --wait-ms must be 1..30000\n"
    exit 2
}
if {![string is integer -strict $max_actions] || $max_actions < 0 || $max_actions > 256} {
    send_user "qute-assist.exp: --max-actions must be 0..256\n"; exit 2
}
if {$bridge_bin eq ""} {
    if {[file executable $DEFAULT_BRIDGE]} { set bridge_bin $DEFAULT_BRIDGE } else { set bridge_bin "ptk-qute-bridge" }
}
if {$cli_bin eq ""} {
    if {[file executable $DEFAULT_CLI]} { set cli_bin $DEFAULT_CLI } else { set cli_bin "prowsetk" }
}
if {$repl_bin eq ""} {
    set selected_cli [auto_execok $cli_bin]
    if {[llength $selected_cli] == 1} {
        set candidate [file normalize [file join [file dirname [lindex $selected_cli 0]] .. .. tools qutebrowser-bridge ptk-qute-repl]]
        if {[file executable $candidate]} { set repl_bin $candidate }
    }
    if {$repl_bin eq ""} {
        if {[file executable $DEFAULT_REPL]} { set repl_bin $DEFAULT_REPL } else { set repl_bin "ptk-qute-repl" }
    }
}
if {$interactive && [auto_execok $repl_bin] eq ""} {
    send_user "qute-assist: ptk-qute-repl unavailable; build with Replxx and Lua, or pass --repl-bin\n"; exit 1
}
# The REPL discovers its own adjacent module. Pair finite drivers with their
# selected CLI instead of loading another preset through the Lua fallback.
if {$ipc_module eq "" && !$interactive} {
    set selected_cli [auto_execok $cli_bin]
    if {[llength $selected_cli] == 1} {
        set module [file normalize [file join [file dirname [lindex $selected_cli 0]] .. .. tools qutebrowser-bridge lquteipc.so]]
        if {[file readable $module]} { set ipc_module $module }
    }
}
if {$actions_file ne "" && ![file readable $actions_file]} {
    send_user "qute-assist.exp: actions file unreadable\n"
    exit 1
}

set bridge_json [file normalize "$directory/bridge.json"]
set broker_cmd [list $bridge_bin serve --directory $directory --url $url --timeout $timeout_secs --max-actions $max_actions]
if {$launch} { lappend broker_cmd --launch --browser $browser }

proc stop_child {child} {
    if {[catch {exp_pid -i $child} child_pid]} { return }
    catch {exec kill -TERM -- $child_pid}
    set stopped 0
    catch {
        expect -i $child -timeout 3 {
            eof { set stopped 1 }
            timeout { }
        }
    }
    if {!$stopped} { catch {exec kill -KILL -- $child_pid} }
    catch {close -i $child}
    catch {wait -i $child}
}
proc cleanup {} {
    global broker_spawn driver_spawn
    if {[info exists driver_spawn]} { stop_child $driver_spawn; unset driver_spawn }
    if {[info exists broker_spawn]} { stop_child $broker_spawn; unset broker_spawn }
}

trap { cleanup; exit 130 } {SIGINT SIGTERM}
set timeout 30

# 0. The broker requires an owner-only (0700) directory and refuses anything
#    else with a generic error, so settle that before spawning it. A live
#    broker for this directory is reused, never evicted; only provably stale
#    state is cleared.
if {![file isdirectory $directory]} {
    if {[catch {file mkdir $directory} err]} {
        send_user "qute-assist: cannot create directory $directory: $err\n"
        exit 1
    }
}
if {[catch {file attributes $directory -permissions 0700} err]} {
    send_user "qute-assist: cannot set owner-only permissions on $directory: $err\n"
    exit 1
}
if {[file exists [file join $directory bridge.json]]} {
    set live 0
    if {[catch {exec $bridge_bin status --bridge [file join $directory bridge.json]}] == 0} {
        set live 1
    }
    if {$live} {
        send_user "qute-assist: a bridge is already serving $directory; use it or finish it first\n"
        exit 1
    }
    send_user "qute-assist: clearing stale bridge state in $directory\n"
    catch {file delete [file join $directory bridge.json]}
    catch {file delete [file join $directory bridge.sock]}
}
if {[file exists [file join $directory bridge.sock]]} {
    send_user "qute-assist: stale socket without a descriptor in $directory; remove bridge.sock and rerun\n"
    exit 1
}

# 1. Broker. With --launch its own y/N approval is relayed to the human.
spawn -noecho {*}$broker_cmd
set broker_spawn $spawn_id
if {$launch} {
    expect {
        -re {Open the configured page.*\[y/N\][^\n]*} {
            send_user "\nqute-assist: the bridge asks: $expect_out(0)\n"
            send_user "qute-assist: open Qutebrowser at $url? \[y/N\] "
            expect_user -timeout 120 -re "(.*)\n" {
                send "$expect_out(1,string)\n"
            } timeout {
                send_user "\nqute-assist: approval timed out\n"
                cleanup; exit 1
            } eof {
                send_user "\nqute-assist: approval cancelled\n"
                cleanup; exit 1
            }
        }
        "qutebrowser bridge ready" { }
        timeout { send_user "qute-assist: broker did not start\n"; cleanup; exit 1 }
        eof { send_user "qute-assist: broker exited early\n"; cleanup; exit 1 }
    }
}
expect {
    "qutebrowser bridge ready" { }
    timeout { send_user "qute-assist: broker did not become ready\n"; cleanup; exit 1 }
    eof { send_user "qute-assist: broker exited before ready\n"; cleanup; exit 1 }
}
send_user "qute-assist: bridge ready; use your already-logged-in admin tab (or log in), then run:\n"
if {!$interactive && $actions_file eq ""} {
    send_user "  :spawn --userscript $DEFAULT_SCRAPE --bridge $bridge_json\n"
} else {
    send_user "  :spawn --userscript $DEFAULT_MARIONETTE --bridge $bridge_json --settle-ms 500\n"
}
if {$interactive} {
    send_user "qute-assist: starting the Lua REPL; attach the marionette above, then use :capture, :targets, :links and :help\n"
    set command [list $repl_bin --bridge $bridge_json --require-login --wait-ms $wait_ms --output $output --postman $postman]
    if {$ipc_module ne ""} { lappend command --ipc-module $ipc_module }
    if {$success_selector ne ""} { lappend command --success-selector $success_selector }
    if {$success_xpath ne ""} { lappend command --success-xpath $success_xpath }
    if {$show_values} { lappend command --show-values }
    spawn -noecho {*}$command
    set driver_spawn $spawn_id
    interact -i $driver_spawn
    set result 1
    if {[catch {wait -i $driver_spawn} child_wait] == 0 && [llength $child_wait] == 4 && [lindex $child_wait 2] == 0} {
        set result [lindex $child_wait 3]
    }
    unset driver_spawn
    cleanup
    send_user "qute-assist: interactive session ended\n"
    exit $result
}
send_user "qute-assist: take your time logging in; the driver starts once the snapshot arrives.\n"

# 2. Wait for the snapshot before starting the driver. The driver's own wait
#    is capped at 30s (wait_ms), far too short for a human login, so the
#    broker's retained revision is the gate: poll status until revision > 0.
set status_cmd [list $bridge_bin status --bridge $bridge_json]
set wait_deadline [expr {[clock seconds] + $timeout_secs - 60}]
if {$wait_deadline < [clock seconds] + 30} { set wait_deadline [expr {[clock seconds] + 30}] }
set polls 0
set revision 0
# 3. Driver. A rejected initial login beacon returns 3 without closing the
# broker. Wait for a NEW capture in that case; never retry dispatched actions.
set driver_cmd [list $cli_bin run booking-admin-api --config $DEFAULT_CONFIG \
    --bridge $bridge_json --output $output --postman $postman --wait_ms $wait_ms --retry_login_evidence true]
if {$actions_file ne ""} { lappend driver_cmd --actions_file $actions_file }
if {$success_selector ne ""} { lappend driver_cmd --success_selector $success_selector }
if {$success_xpath ne ""} { lappend driver_cmd --success_xpath $success_xpath }
if {$ipc_module ne ""} { lappend driver_cmd --ipc_module $ipc_module }
set driver_status 1
while {1} {
    set snapshot_ready 0
    while {[clock seconds] < $wait_deadline} {
        if {[catch {exec {*}$status_cmd} status_out] != 0} {
            send_user "qute-assist: broker unavailable while waiting for a snapshot\n"
            cleanup; exit 1
        }
        if {[regexp {"closed":\s*true} $status_out]} {
            send_user "qute-assist: conversation was finished before a usable snapshot arrived\n"
            cleanup; exit 1
        }
        if {[regexp {"revision":\s*([0-9]+)} $status_out -> rev] && $rev > $revision} {
            set revision $rev
            set snapshot_ready 1
            break
        }
        after 5000
        incr polls
        if {$polls % 12 == 0} {
            set left [expr {$wait_deadline - [clock seconds]}]
            send_user "qute-assist: still waiting for the snapshot (${left}s left); send it with the :spawn line above\n"
        }
    }
    if {!$snapshot_ready} {
        send_user "qute-assist: no usable snapshot arrived within the login window; rerun with a larger --timeout\n"
        cleanup; exit 1
    }
    send_user "qute-assist: snapshot received; starting the driver\n"
    spawn -noecho {*}$driver_cmd
    set driver_spawn $spawn_id
    set wait_s [expr {int($wait_ms / 1000)}]
    if {$actions_file eq ""} { set timeout [expr {$wait_s + 120}] } else { set timeout 1200 }
    set driver_status 1
    expect {
        -i $driver_spawn eof {
            if {[catch {wait -i $driver_spawn} driver_wait] == 0 && [llength $driver_wait] == 4 &&
                [lindex $driver_wait 2] == 0} {
                set driver_status [lindex $driver_wait 3]
            }
        }
        -i $driver_spawn timeout {
            send_user "qute-assist: driver timed out\n"
            stop_child $driver_spawn
        }
    }
    unset driver_spawn
    if {$driver_status != 3} { break }
    send_user "qute-assist: keeping the bridge open; open the account menu in your logged-in tab and send a fresh snapshot\n"
    if {$actions_file eq ""} {
        send_user "qute-assist: use the same :spawn line above\n"
    } else {
        # The original marionette is still attached. Publish an updated capture
        # without trying to attach a second controller to the same conversation.
        send_user "  :spawn --userscript $DEFAULT_SCRAPE --bridge $bridge_json\n"
    }
}

cleanup
if {$driver_status == 0} {
    send_user "qute-assist: specs exported ($output, $postman)\n"
} else {
    send_user "qute-assist: driver failed; see the stage-specific message above (exports may be incomplete)\n"
}
exit $driver_status
