#!/usr/bin/expect -f
# Cloudflare Browser Run snapshot-to-specs run for booking-admin-api.
#
# Fetches a rendered admin snapshot via plugins/browser-run-integration, then
# feeds it to the existing pipeline with no further questions. Credentials are
# asked for only when neither the environment nor Prowse.toml [cloudflare] (nor
# the oauth-assist cache behind them) can supply them; the token is read with
# echo disabled and never displayed, logged, or passed on any command line.
# Nothing here bypasses CAPTCHAs: satisfy any challenge in the remote session
# first, then re-run to re-snapshot.
#
# Usage:
#   browser-run-assist.exp [--output SNAP.html] [--url URL] [--config TOML]
#     [--to driver|marionette] [--openapi FILE] [--postman FILE]
#     [--decisions FILE] [--fetch-bin BIN] [--marionette-bin BIN]
#     [--cli-bin BIN] [--ipc-module SO] [--api-only true|false]
#     [--verbose] [--no-xcors BOOL] [--max-steps N] [--max-page-requests N]
#     [--opencode-max-requests N] [--opencode-wait-ms MS] [--opencode-api-prefix /api]
#     [--help]
#
# --to driver (default) needs only the built CLI, but it passes the markup
# inline as an argv argument, so it is capped at 512 KiB. --to marionette reads
# the snapshot file directly (up to the 16 MiB snapshot bound) and needs a
# running OpenCode server. This path is independent of the Qutebrowser broker:
# see qute-assist.exp for the interactive console.
#
# --verbose, --no-xcors, --max-steps, --max-page-requests, --opencode-max-requests,
# --opencode-wait-ms and --opencode-api-prefix tune the marionette only and are
# ignored by --to driver. A snapshot run is offline with a deterministic page
# transport, so the runner forces GET schema probes to zero; Booking login
# preparation is not part of this launcher (see scripts/run-scrape-booking.sh).
#
# Telemetry and error-reporting candidates are filtered out of both
# downstreams by default; --api-only false keeps every discovered same-origin
# candidate for manual review.
#
# Exit: 0 on exported specs, 1 on fetch/driver failure, 2 on usage errors.

# Robust output: after stdin reaches EOF, plain send_user can throw
# ("spawn id not open"); diagnostics must never fail the run itself.
rename send_user orig_send_user
proc send_user {args} { catch {uplevel 1 [list orig_send_user {*}$args]} }

# Reject values the runner could not parse, with the same wording the wrapper
# uses, so an unusable option never reaches a command line.
proc unsigned_value {name value} {
    if {![regexp {^[0-9]+$} $value]} {
        send_user "browser-run-assist.exp: $name must be a non-negative integer\n"
        exit 2
    }
}
proc boolean_value {name value} {
    if {$value ne "true" && $value ne "false"} {
        send_user "browser-run-assist.exp: $name must be true or false\n"
        exit 2
    }
}

set HERE [file dirname $argv0]
set DEFAULT_CONFIG [file normalize "$HERE/Prowse.toml"]
set DEFAULT_FETCH [file normalize "$HERE/fetch-browser-run-snapshot.sh"]
set DEFAULT_MARIONETTE [file normalize "$HERE/run-opencode-marionette.sh"]
set DEFAULT_DECISIONS [file normalize "$HERE/marionette-decisions.json"]
set DEFAULT_CLI [file normalize "$HERE/../../build/default/src/cli/prowsetk"]

set snapshot "_scraped/booking-admin-browser-run.html"
set url "https://admin.booking.com/"
set config $DEFAULT_CONFIG
set to "driver"
set openapi "_scraped/booking-admin-openapi.yaml"
set postman "_scraped/booking-admin-postman.json"
set decisions $DEFAULT_DECISIONS
set fetch_bin ""
set marionette_bin ""
set cli_bin ""
set ipc_module ""
set api_only "true"
set verbose 0
set no_xcors ""
set max_steps ""
set max_page_requests ""
set opencode_max_requests ""
set opencode_wait_ms ""
set opencode_api_prefix ""

proc usage {} {
    send_user "Usage: browser-run-assist.exp \[options]\n"
    send_user "  --output SNAP      snapshot file (default: _scraped/booking-admin-browser-run.html)\n"
    send_user "  --url URL          must stay on https://admin.booking.com (default)\n"
    send_user "  --config TOML      project config with optional \[cloudflare\] (default: Prowse.toml)\n"
    send_user "  --to driver|marionette  downstream consumer (default: driver)\n"
    send_user "  --openapi FILE     specs output (default: _scraped/booking-admin-openapi.yaml)\n"
    send_user "  --postman FILE     Postman output (default: _scraped/booking-admin-postman.json)\n"
    send_user "  --decisions FILE   marionette policy (default: marionette-decisions.json)\n"
    send_user "  --fetch-bin BIN    fetch-browser-run-snapshot.sh override\n"
    send_user "  --marionette-bin B run-opencode-marionette.sh override\n"
    send_user "  --cli-bin BIN      prowsetk CLI override\n"
    send_user "  --ipc-module SO    lquteipc override\n"
    send_user "  --api-only BOOL    keep every same-origin candidate, true|false (default: true)\n"
    send_user "  --verbose          value-free marionette stage/network diagnostics\n"
    send_user "  --no-xcors BOOL    booking.com-only export filter (marionette only)\n"
    send_user "  --max-steps N      marionette action budget (marionette only)\n"
    send_user "  --max-page-requests N  marionette page-request budget (marionette only)\n"
    send_user "  --opencode-max-requests N  agent request budget (marionette only)\n"
    send_user "  --opencode-wait-ms MS  cap on waiting for an agent reply (marionette only)\n"
    send_user "  --opencode-api-prefix /api  OpenCode V2 route prefix (marionette only)\n"
    send_user "  --help             this text\n"
}

set i 0
while {$i < [llength $argv]} {
    set opt [lindex $argv $i]
    if {$opt eq "--help" || $opt eq "-h"} { usage; exit 0 }
    if {$opt eq "--verbose" || $opt eq "-v" || $opt eq "--verbse"} { set verbose 1; incr i; continue }
    if {$opt ni {"--output" "--url" "--config" "--to" "--openapi" "--postman" "--decisions" "--fetch-bin" "--marionette-bin" "--cli-bin" "--ipc-module" "--api-only" "--no-xcors" "--max-steps" "--max-page-requests" "--opencode-max-requests" "--opencode-wait-ms" "--opencode-api-prefix"}} {
        send_user "browser-run-assist.exp: unknown option $opt\n"; exit 2
    }
    if {$i + 1 >= [llength $argv]} { send_user "browser-run-assist.exp: missing value for $opt\n"; exit 2 }
    set val [lindex $argv [expr {$i + 1}]]
    switch -- $opt {
        "--output"       { set snapshot $val }
        "--url"          { set url $val }
        "--config"       { set config $val }
        "--to"           { set to $val }
        "--openapi"      { set openapi $val }
        "--postman"      { set postman $val }
        "--decisions"    { set decisions $val }
        "--fetch-bin"    { set fetch_bin $val }
        "--marionette-bin" { set marionette_bin $val }
        "--cli-bin"      { set cli_bin $val }
        "--ipc-module"   { set ipc_module $val }
        "--api-only"     { set api_only $val }
        "--no-xcors"     { boolean_value $opt $val; set no_xcors $val }
        "--max-steps"        { unsigned_value $opt $val; set max_steps $val }
        "--max-page-requests" { unsigned_value $opt $val; set max_page_requests $val }
        "--opencode-max-requests" { unsigned_value $opt $val; set opencode_max_requests $val }
        "--opencode-wait-ms" { unsigned_value $opt $val; set opencode_wait_ms $val }
        "--opencode-api-prefix" {
            if {$val ne "/api"} {
                send_user "browser-run-assist.exp: --opencode-api-prefix must be /api\n"; exit 2
            }
            set opencode_api_prefix $val
        }
        default { send_user "browser-run-assist.exp: unknown option $opt\n"; exit 2 }
    }
    incr i 2
}
if {![string match "https://admin.booking.com*" $url]} {
    send_user "browser-run-assist.exp: URL must stay on https://admin.booking.com\n"
    exit 2
}
if {$to ne "driver" && $to ne "marionette"} {
    send_user "browser-run-assist.exp: --to must be driver or marionette\n"
    exit 2
}
if {$api_only ni {"true" "false"}} {
    send_user "browser-run-assist.exp: --api-only must be true or false\n"
    exit 2
}
# Marionette tuning has no meaning for the offline --to driver import; say so
# once instead of accepting an option that cannot take effect.
if {$to eq "driver" && ($verbose || $no_xcors ne "" || $max_steps ne "" ||
        $max_page_requests ne "" || $opencode_max_requests ne "" ||
        $opencode_wait_ms ne "" || $opencode_api_prefix ne "")} {
    send_user "browser-run-assist.exp: marionette options are ignored by --to driver; use --to marionette\n"
}
if {$fetch_bin eq ""} { set fetch_bin $DEFAULT_FETCH }
if {![file executable $fetch_bin]} {
    send_user "browser-run-assist.exp: fetch helper not executable: $fetch_bin\n"
    exit 1
}
if {$cli_bin eq ""} {
    if {[file executable $DEFAULT_CLI]} { set cli_bin $DEFAULT_CLI } else { set cli_bin "prowsetk" }
}

# 1. Credentials: prompt only for what the environment does not already carry.
#    Passed to children via the environment, never via argv or output.
global env
if {![info exists env(CLOUDFLARE_ACCOUNT_ID)] || $env(CLOUDFLARE_ACCOUNT_ID) eq ""} {
    send_user "CLOUDFLARE_ACCOUNT_ID (32-char hex, empty for oauth-assist cache): "
    expect_user -timeout 120 -re "(.*)\n" {
        set env(CLOUDFLARE_ACCOUNT_ID) [string trim $expect_out(1,string)]
    } timeout { send_user "\nbrowser-run-assist: input timed out\n"; exit 1 } \
      eof { send_user "\nbrowser-run-assist: input cancelled\n"; exit 1 }
}
if {![info exists env(CLOUDFLARE_API_TOKEN)] || $env(CLOUDFLARE_API_TOKEN) eq ""} {
    send_user "CLOUDFLARE_API_TOKEN (empty for TOML/oauth-assist cache): "
    catch {system "stty -echo"}
    expect_user -timeout 120 -re "(.*)\n" {
        set env(CLOUDFLARE_API_TOKEN) [string trim $expect_out(1,string)]
    } timeout { catch {system "stty echo"}; send_user "\nbrowser-run-assist: input timed out\n"; exit 1 } \
      eof { catch {system "stty echo"}; send_user "\nbrowser-run-assist: input cancelled\n"; exit 1 }
    catch {system "stty echo"}
    send_user "\n"
}

# 2. Fetch. The helper refuses existing outputs and keeps tokens off argv.
set timeout 180
spawn -noecho $fetch_bin --output $snapshot --url $url --config $config
set fetch_status 1
expect {
    -i $spawn_id "Browser Run operation completed" { set fetch_status 0 }
    -i $spawn_id timeout { send_user "browser-run-assist: fetch timed out\n" }
    -i $spawn_id eof {
        if {[catch {wait -i $spawn_id} w] == 0 && [llength $w] >= 4} {
            set fetch_status [lindex $w 3]
        }
    }
}
if {$fetch_status != 0} {
    send_user "browser-run-assist: snapshot fetch failed (check credentials and login state)\n"
    exit 1
}
send_user "browser-run-assist: snapshot saved ($snapshot)\n"

# 3. Downstream: no further input.
if {$to eq "marionette"} {
    if {$marionette_bin eq ""} { set marionette_bin $DEFAULT_MARIONETTE }
    if {![file executable $marionette_bin]} {
        send_user "browser-run-assist: marionette runner not executable: $marionette_bin\n"
        exit 1
    }
    if {[catch {file size $snapshot} snap_size] != 0} {
        send_user "browser-run-assist: snapshot unreadable\n"
        exit 1
    }
    # The runner reads the file directly, so this path has no argv-size cap.
    send_user "browser-run-assist: marionette mode (${snap_size} bytes, needs a running OpenCode server)\n"
    set timeout 1500
    set marionette_cmd [list $marionette_bin --snapshot $snapshot --decisions $decisions \
        --output $openapi --postman $postman --url $url]
    if {$verbose} { lappend marionette_cmd --verbose }
    if {$no_xcors ne ""} { lappend marionette_cmd --no-xcors $no_xcors }
    if {$max_steps ne ""} { lappend marionette_cmd --max-steps $max_steps }
    if {$max_page_requests ne ""} { lappend marionette_cmd --max-page-requests $max_page_requests }
    if {$opencode_max_requests ne ""} { lappend marionette_cmd --opencode-max-requests $opencode_max_requests }
    if {$opencode_wait_ms ne ""} { lappend marionette_cmd --opencode-wait-ms $opencode_wait_ms }
    if {$opencode_api_prefix ne ""} { lappend marionette_cmd --opencode-api-prefix $opencode_api_prefix }
    spawn -noecho {*}$marionette_cmd
    set downstream "marionette"
} else {
    if {[catch {file size $snapshot} snap_size] != 0} {
        send_user "browser-run-assist: snapshot unreadable\n"
        exit 1
    }
    if {$snap_size > 524288} {
        send_user "browser-run-assist: snapshot is ${snap_size} bytes; the driver takes markup as an argv\n"
        send_user "browser-run-assist: argument, so rerun with --to marionette for snapshots over 512 KiB\n"
        exit 1
    }
    set fh [open $snapshot r]
    set html [read $fh]
    close $fh
    set driver_cmd [list $cli_bin run booking-admin-api --config $config \
        --html $html --output $openapi --postman $postman --api_only $api_only]
    if {$ipc_module ne ""} { lappend driver_cmd --ipc_module $ipc_module }
    set timeout 300
    spawn -noecho {*}$driver_cmd
    set downstream "driver"
}
set final 1
expect {
    -i $spawn_id eof {
        if {[catch {wait -i $spawn_id} w] == 0 && [llength $w] >= 4} {
            set final [lindex $w 3]
        } else {
            set final 0
        }
    }
    -i $spawn_id timeout {
        send_user "browser-run-assist: $downstream timed out\n"
        catch {exec kill [exp_pid $spawn_id]}
    }
}
if {$final == 0} {
    send_user "browser-run-assist: specs exported ($openapi, $postman)\n"
} else {
    send_user "browser-run-assist: $downstream failed; previous exports preserved\n"
}
exit $final
