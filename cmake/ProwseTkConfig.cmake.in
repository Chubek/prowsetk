@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@PROWSETK_HAVE_OPENSSL@)
    find_dependency(OpenSSL 3.0 COMPONENTS SSL Crypto)
endif()
if(@PROWSETK_SYSTEM_OAUTHCPP@)
    find_dependency(liboauthcpp CONFIG)
endif()
if(@PROWSETK_GFX_X11@ OR (@PROWSETK_GFX_FLTK@ AND CMAKE_SYSTEM_NAME STREQUAL "Linux"))
    find_dependency(X11)
endif()
if(@PROWSETK_GFX_FLTK@)
    find_dependency(FLTK CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ProwseTkTargets.cmake")

check_required_components(ProwseTk)
